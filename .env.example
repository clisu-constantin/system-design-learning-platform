# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Web app (read by Vite at build time) ---------------------------------------
# Leave the VITE_FIREBASE_* variables empty and the app builds and runs as a Guest only.
VITE_API_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=your-firebase-app-id

# --- API (server/) ---------------------------------------------------------------
# The Postgres of `docker compose up db`. Railway sets its own (postgresql://...); both
# postgres:// and postgresql:// work, the server picks the psycopg 3 driver itself.
DATABASE_URL=postgresql://sdi:sdi@localhost:5432/sdi
# The same Firebase project as VITE_FIREBASE_PROJECT_ID: tokens of any other project are refused.
FIREBASE_PROJECT_ID=your-project
# Web app origins allowed by CORS, comma-separated.
ALLOWED_ORIGIN=http://localhost:5173
# Set by Railway; locally the API listens on 8000.
# PORT=8000

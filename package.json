{
  "name": "system-design-interactive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive System Design laboratory - learn architecture by seeing systems work.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-visuals.mjs && node scripts/check-content.mjs && tsc -b && vite build",
    "start": "serve -s dist -l ${PORT:-3000}",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "check:visuals": "node scripts/check-visuals.mjs",
    "check:content": "node scripts/check-content.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "reactflow": "^11.11.4",
    "recharts": "^2.13.3",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
